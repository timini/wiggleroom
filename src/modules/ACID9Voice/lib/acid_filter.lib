// acid_filter.lib - Dual filter architecture (ACID / LEAD)
// Part of ACID9Voice module for WiggleRoom VCV Rack plugin
//
// ACID mode: coupled four-stage diode ladder, bass loss at high resonance
// LEAD mode: four-pole TPT ladder with progressive, bounded resonance
// Crossfade: smoothed linear blend between continuously running filters

import("stdfaust.lib");

// Coupled TPT diode ladder, adapted from Csound wpfilters.c (Steven Yi, 2017),
// LGPL-2.1-or-later, based on Will Pirkle's zero-delay-feedback formulation.
// Reference: https://github.com/csound/csound/blob/develop/Opcodes/wpfilters.c
// The four integrator states are solved with their instantaneous feedback;
// this is not four independent biquads. Input saturation models drive.
diode_ladder_zdf(fc,res,sig) = sig : (loop ~ (_,_,_,_) : !,!,!,!,_)
with {
    g = tan(ma.PI*max(20,min(fc,ma.SR*.4))/ma.SR);
    gp = 1+g; alpha=g/gp; k=16.5*max(0,min(res,1));
    G4=.5*g/gp; G3=.5*g/(gp-.5*g*G4);
    G2=.5*g/(gp-.5*g*G3); G1=g/(gp-g*G2);
    b1=1/(gp-g*G2); b2=1/(gp-.5*g*G3); b3=1/(gp-.5*g*G4); b4=1/gp;
    loop(z1,z2,z3,z4,x) = z1+2*v1,z2+2*v2,z3+2*v3,z4+2*v4,y4
    with {
        f4=b4*z4; f3=b3*(z3+.5*g*f4); f2=b2*(z2+.5*g*f3); f1=b1*(z1+g*f2);
        sigma=G4*G3*G2*f1+G4*G3*f2+G4*f3+f4;
        u=(ma.tanh(x)-k*sigma)/(1+k*G1*G2*G3*G4);
        v1=alpha*(u*(1+G1*G2)+f2+G2*f1-z1); y1=v1+z1;
        v2=alpha*(.5*(y1*(1+G2*G3)+f3+G3*f2)-z2); y2=v2+z2;
        v3=alpha*(.5*(y2*(1+G3*G4)+f4+G4*f3)-z3); y3=v3+z3;
        v4=alpha*(.5*y3-z4); y4=v4+z4;
    };
};

// ============================================================================
// OTA LADDER FILTER (24dB/octave) - LEAD MODE
// ============================================================================

// Faust's coupled TPT ladder (Dario Sanfilippo, vaeffects.lib).
// Keep feedback below the k=4 oscillation threshold. Squaring the control
// spreads the useful mild-resonance range across more of the knob travel.
ota_ladder(fc, res) = ma.tanh : ve.lowpassLadder4(k, fc_safe)
with {
    fc_safe = max(20, min(fc, ma.SR * 0.4));
    k = 3.6 * res * res;
};

// ============================================================================
// DUAL FILTER WITH CROSSFADE
// ============================================================================

// Dual filter with partial Acid bass-loss compensation and linear crossfade
// mode: 0 = ACID (diode ladder), 1 = LEAD (four-pole TPT ladder)
// fc: cutoff frequency in Hz
// res: resonance (0-1)
dual_filter(fc, res, mode, sig) = output
with {
    // Clamp parameters
    fc_clamped = max(20, min(fc, ma.SR * 0.45));
    res_clamped = max(0, min(res, 0.99));

    // Filter outputs
    acid_out = (sig : diode_ladder_zdf(fc_clamped, res_clamped)) * (1 + 4.5 * res_clamped) * (1.5 - 0.8 * res_clamped * res_clamped);
    lead_out = sig : ota_ladder(fc_clamped, res_clamped);

    // Correlated signals must not receive the equal-power midpoint boost.
    mode_smooth = max(0, min(mode, 1)) : si.smooth(ba.tau2pole(0.01));
    acid_gain = 1 - mode_smooth;
    lead_gain = mode_smooth;

    // Mix
    output = acid_out * acid_gain + lead_out * lead_gain;
};

// Stereo version
dual_filter_stereo(fc, res, mode) = dual_filter(fc, res, mode), dual_filter(fc, res, mode);

// ============================================================================
// GRIT SATURATION
// ============================================================================

// Pre-filter saturation (grit control)
// Creates even-order harmonics for that "dirty" sound
// amount: 0 = clean, 1 = heavily saturated
grit_sat(amount, sig) = output
with {
    amount_smooth = amount : si.smoo;

    // More aggressive drive: max 7x into tanh
    drive = 1 + amount_smooth * 6;

    // Stronger asymmetric saturation for richer even harmonics
    asymmetric_sat(x) = ma.tanh(x * drive) * (1 + 0.6 * amount_smooth * x * x);

    saturated = sig : asymmetric_sat;

    // Gentler drive compensation - let it get louder
    drive_comp = 1.0 / (1 + amount_smooth * 0.25);

    // Less clean signal in the mix - fully saturated at max grit
    output = (sig * max(0, 1 - amount_smooth * 1.5) + saturated * amount_smooth) * drive_comp;
};

// Stereo grit
grit_sat_stereo(amount) = grit_sat(amount), grit_sat(amount);

// ============================================================================
// FILTER ENVELOPE
// ============================================================================

// AD envelope for filter modulation
// gate: trigger signal
// attack: attack time in seconds
// decay: decay time in seconds
filter_env(gate, attack, decay) = en.adsr(attack, decay, 0, 0.01, gate);

// Filter envelope with accent boost
// When accent is active, envelope depth is multiplied
filter_env_accent(gate, attack, decay, accent, accent_boost) = env * boost
with {
    env = filter_env(gate, attack, decay);
    boost = 1.0 + accent * (accent_boost - 1.0);
};
